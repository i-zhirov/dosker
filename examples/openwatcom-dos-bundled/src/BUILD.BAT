@ECHO OFF
C:
CD \APP
IF NOT EXIST C:\TMP\NUL MD C:\TMP >NUL
SET TMP=C:\TMP
SET TEMP=C:\TMP
SET WATCOM=C:\WATCOM
SET DOS4GPATH=%WATCOM%\BINW
SET PATH=%WATCOM%\BINW;%PATH%
SET INCLUDE=%WATCOM%\H;%WATCOM%\H\SYS
SET LIB=%WATCOM%\LIB286;%WATCOM%\LIB286\DOS;%WATCOM%\LIB386;%WATCOM%\LIB386\DOS
WCC -0 -bt=dos -ml -zq -wx -we -i=%WATCOM%\H -fo=HELLO.OBJ HELLO.C
IF ERRORLEVEL 1 GOTO FAIL
WLINK SYSTEM DOS NAME HELLO.EXE FILE HELLO.OBJ OPTION STACK=8192 OPTION MAP=HELLO.MAP
IF ERRORLEVEL 1 GOTO FAIL
ECHO BUILD OK
GOTO END
:FAIL
ECHO BUILD FAILED
:END
