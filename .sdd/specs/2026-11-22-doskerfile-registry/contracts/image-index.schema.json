{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dosker.dev/schemas/image-index.schema.json",
  "title": "DOSker registry per-image index",
  "description": "Schema for the generated /v1/<owner>/<name>/index.json on GitHub Pages.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "image", "namespace", "name", "description", "tags", "versions"],
  "properties": {
    "schema": {
      "const": 1
    },
    "image": {
      "$ref": "#/$defs/ref"
    },
    "namespace": {
      "$ref": "#/$defs/handle"
    },
    "name": {
      "$ref": "#/$defs/name"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 280
    },
    "homepage": {
      "type": "string",
      "format": "uri"
    },
    "deprecated": {
      "type": "string",
      "minLength": 1,
      "maxLength": 280
    },
    "tags": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "$ref": "#/$defs/tag"
      },
      "additionalProperties": {
        "$ref": "#/$defs/digest"
      }
    },
    "versions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/version"
      }
    }
  },
  "$defs": {
    "handle": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,37}[a-z0-9])?$"
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_.-]{0,62}$"
    },
    "ref": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,37}[a-z0-9])?/[a-z0-9][a-z0-9_.-]{0,62}$"
    },
    "tag": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "license_summary": {
      "enum": ["redistributable", "abandonware", "mixed"]
    },
    "version": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "digest",
        "config_digest",
        "manifest_url",
        "config_url",
        "asset_url",
        "asset_digest",
        "asset_size",
        "published_at",
        "license_summary",
        "licenses_url"
      ],
      "properties": {
        "version": {
          "$ref": "#/$defs/tag"
        },
        "digest": {
          "$ref": "#/$defs/digest"
        },
        "config_digest": {
          "$ref": "#/$defs/digest"
        },
        "manifest_url": {
          "type": "string",
          "format": "uri"
        },
        "config_url": {
          "type": "string",
          "format": "uri"
        },
        "asset_url": {
          "type": "string",
          "format": "uri"
        },
        "asset_digest": {
          "$ref": "#/$defs/digest"
        },
        "asset_size": {
          "type": "integer",
          "minimum": 1
        },
        "published_at": {
          "type": "string",
          "format": "date-time"
        },
        "license_summary": {
          "$ref": "#/$defs/license_summary"
        },
        "licenses_url": {
          "type": "string",
          "format": "uri"
        }
      }
    }
  }
}
