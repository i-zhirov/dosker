{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dosker.dev/schemas/licenses.schema.json",
  "title": "DOSker image license record",
  "description": "Schema for the generated /v1/<owner>/<name>/versions/<digest>/licenses.json. Entries mirror the Doskerfile LICENSE instructions.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "image", "digest", "config_digest", "summary", "entries"],
  "properties": {
    "schema": {
      "const": 1
    },
    "image": {
      "$ref": "#/$defs/ref"
    },
    "digest": {
      "$ref": "#/$defs/digest"
    },
    "config_digest": {
      "$ref": "#/$defs/digest"
    },
    "summary": {
      "$ref": "#/$defs/summary"
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/entry"
      }
    }
  },
  "$defs": {
    "ref": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,37}[a-z0-9])?/[a-z0-9][a-z0-9_.-]{0,62}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "summary": {
      "enum": ["redistributable", "abandonware", "mixed"]
    },
    "spdx": {
      "type": "string",
      "pattern": "^(NONE|[A-Za-z0-9][A-Za-z0-9.+-]*( +(AND|OR|WITH) +[A-Za-z0-9][A-Za-z0-9.+-]*)*)$"
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "spdx", "status"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.+-]*$"
        },
        "spdx": {
          "$ref": "#/$defs/spdx"
        },
        "holder": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "status": {
          "enum": ["redistributable", "abandonware"]
        },
        "basis": {
          "enum": [
            "open-source-license",
            "freeware-release",
            "public-domain",
            "rights-holder-statement",
            "good-faith"
          ]
        },
        "evidence": {
          "type": "string",
          "format": "uri"
        },
        "license_url": {
          "type": "string",
          "format": "uri"
        },
        "covers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "source_url": {
          "type": "string",
          "format": "uri"
        },
        "notice": {
          "type": "string",
          "maxLength": 2000
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "abandonware"
              }
            },
            "required": ["status"]
          },
          "then": {
            "required": ["basis", "evidence"]
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "redistributable"
              },
              "spdx": {
                "const": "NONE"
              }
            },
            "required": ["status", "spdx"]
          },
          "then": {
            "required": ["basis", "evidence"]
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "abandonware"
              }
            },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "spdx": {
                "const": "NONE"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "basis": {
                "const": "good-faith"
              }
            },
            "required": ["basis"]
          },
          "then": {
            "properties": {
              "status": {
                "const": "abandonware"
              }
            }
          }
        }
      ]
    }
  }
}
